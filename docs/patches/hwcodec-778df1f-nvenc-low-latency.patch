+    // Without these FFmpeg nvenc runs its defaults, preset p4 with tune hq,
+    // tuned for quality rather than latency. Best effort: an option this
+    // FFmpeg build does not know keeps its default instead of failing the
+    // encoder (this function also runs in the availability test encode).
+    // The driver only checks preset/tune in avcodec_open2; P2 with ULL is in
+    // the documented NVENC preset matrix for H.264 and HEVC.
+    const char *low_latency[][2] = {
+        {"preset", "p2"}, {"tune", "ull"}, {"zerolatency", "1"}, {"rc-lookahead", "0"}};
+    for (const auto &opt : low_latency) {
+      if ((ret = av_opt_set(priv_data, opt[0], opt[1], 0)) < 0) {
+        LOG_WARN(std::string("nvenc set ") + opt[0] + "=" + opt[1] + " failed, ret = " +
+                 av_err2str(ret));
+      }
+    }
